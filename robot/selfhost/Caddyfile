# =====================================================================
#  セルフホストの入口（http://<Pi の IP>/）
#    /rest/v1/…  → rest（PostgREST）。Supabase と同じ道順にしてあるので、アプリもロボも同じコードのまま使える
#    それ以外    → web（アプリの画面）
#  http だけ（鍵マークなし）。このアプリは https 専用のブラウザ機能を使っていないので、これで動く
# =====================================================================

:80 {
	handle_path /rest/v1/* {
		reverse_proxy rest:3000 {
			# アプリとロボは Supabase のキーを Authorization に付けて送ってくる。
			# セルフホストの PostgREST は鍵を持たない（全員 anon ＝ Supabase の anon と同じ権限）ので、
			# 付いたまま渡すと「鍵を確かめられない」と断られる。ここで外してから渡す
			header_up -Authorization
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
